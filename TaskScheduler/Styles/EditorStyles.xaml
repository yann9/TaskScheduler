<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:TaskScheduler.Converters">

    <!--
        编辑器（任务设置窗口）专用的带键样式。

        为什么放在 Application.Resources 而不是 TaskEditorWindow.Resources：
        四个分区是独立的 UserControl，各自的 XAML 在 InitializeComponent() 时解析 ——
        那一刻它们还没有父级，StaticResource 沿树向上找不到 Window.Resources，
        会直接抛 "Cannot find resource named ..."。带 x:Key 的资源必须是应用级的。

        这些样式全部带 x:Key，因此不会污染主窗口 / 设置窗口的同名控件；
        真正全局生效的隐式样式（TextBox 高度等）仍旧只定义在编辑器窗口的资源里。

        ⚠ 本文件必须自包含：合并字典（本文件由 App.xaml 的 MergedDictionaries 引入）里的
        **模板内容**（DataTemplate / ControlTemplate / Style）是延迟加载的 —— 等到第一次
        实例化时才去解析其中的 StaticResource，那时的查找上下文只有「本字典 + 本字典的合并项」，
        **看不到把它合并进去的那个上层字典**。所以下面 EnumItem 用到的 EnumCn 必须在这里就地声明，
        不能指望 App.xaml 里那份（那样会在打开任务编辑器 / 设置窗口时抛
        "无法找到名为 EnumCn 的资源"）。普通元素属性上的 StaticResource 不受此限。
    -->

    <!-- 枚举 → 中文。就地声明（不在 App.xaml），原因见上面的 ⚠ -->
    <conv:EnumChineseConverter x:Key="EnumCn"/>

    <!-- 枚举下拉项的统一样式：所有 ComboBox 复用它，省掉每个下拉框各写一遍模板 -->
    <DataTemplate x:Key="EnumItem">
        <TextBlock Text="{Binding Converter={StaticResource EnumCn}}"/>
    </DataTemplate>

    <!--
        Card / CardTitle / FieldLabel / Hint 位于 Styles/Theme.xaml（全局主题，2026-09-24
        起所有窗口共用一份，改观感只动 Theme —— 原则：原生优先，不自绘控件）。
        这里只保留"编辑器语义"的件：枚举模板、脚注、小结条。
    -->

    <Style x:Key="Footnote" TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Foreground" Value="#B26A00"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>

    <!-- 小结条：用于"当前条件：必须满足…"这类一句话说明 -->
    <Style x:Key="SummaryBar" TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Foreground" Value="#185FA5"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
</ResourceDictionary>
