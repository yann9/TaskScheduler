<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        全局主题 —— 经典工具风（2026-09-24 第五版，替代 Win11 Fluent 模仿路线）。

        定位：这是一个工具软件。不要卡片阴影、不要圆角浮起、不要材质；
        层次来自三件事：① 灰 chrome 条（菜单/工具/状态栏）与白内容区分区；
        ② 分区面板的 1px 可见实线边框（#B9B9B9）；③ 控件自身的原生观感。
        参照物：services.msc / Sysinternals / VS 属性页 —— 朴素、边界清楚。

        设计规范（改动保持一致）：
          · 窗口：白底；chrome 条 #F0F0F0 + #D0D0D0 分隔线
          · 面板：白底、1px #B9B9B9 实线、方角（层次靠边框，不靠明度差和阴影）
          · 按钮：标准款白底细边框、高 26；强调款 Accent 底白字
          · 文字：近黑 #1B1B1B（不用纯黑）、次级 #5C5C5C、弱化 #8A8A8A
          · 选中：经典浅蓝 #CCE4F7（非 Win11 淡蓝）
          · 全窗口 TextFormattingMode=Display —— WPF 中文默认渲染发糊，这是"显旧"的
            大头，谁新开窗口都别忘了这行（隐式 Window 样式已兜底）
    -->

    <!-- ===== 色板 ===== -->
    <SolidColorBrush x:Key="AccentBrush"        Color="#0067C0"/>
    <SolidColorBrush x:Key="AccentHoverBrush"   Color="#1975C5"/>
    <SolidColorBrush x:Key="AccentPressBrush"   Color="#005BA1"/>
    <SolidColorBrush x:Key="AccentDisabledBrush" Color="#B4BDC7"/>
    <SolidColorBrush x:Key="PageBgBrush"        Color="White"/>
    <SolidColorBrush x:Key="CardBgBrush"        Color="White"/>
    <SolidColorBrush x:Key="CardBorderBrush"    Color="#B9B9B9"/>
    <SolidColorBrush x:Key="ChromeBgBrush"      Color="#EAEAEA"/>
    <SolidColorBrush x:Key="ChromeBorderBrush"  Color="#CFCFCF"/>
    <SolidColorBrush x:Key="SelBgBrush"         Color="#CCE4F7"/>
    <SolidColorBrush x:Key="DividerBrush"       Color="#E0E0E0"/>
    <SolidColorBrush x:Key="CtrlBorderBrush"    Color="#D9D9D9"/>
    <SolidColorBrush x:Key="CtrlHoverBgBrush"   Color="#F5F5F5"/>
    <SolidColorBrush x:Key="CtrlPressBgBrush"   Color="#F0F0F0"/>
    <SolidColorBrush x:Key="TitleFgBrush"       Color="#1B1B1B"/>
    <SolidColorBrush x:Key="BodyFgBrush"        Color="#3B3B3B"/>
    <SolidColorBrush x:Key="SubFgBrush"         Color="#5C5C5C"/>
    <SolidColorBrush x:Key="MetaFgBrush"        Color="#8A8A8A"/>
    <SolidColorBrush x:Key="WarnFgBrush"        Color="#9A6300"/>
    <SolidColorBrush x:Key="LinkFgBrush"        Color="#0067C0"/>
    <SolidColorBrush x:Key="DangerBrush"        Color="#C42B1C"/>

    <!-- ===== 隐式样式：全窗口统一 ===== -->
    <Style TargetType="Window">
        <Setter Property="Background" Value="{StaticResource PageBgBrush}"/>
        <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
        <Setter Property="FontSize" Value="12"/>
        <!-- 中文清晰度的关键：像素对齐渲染（默认的 Ideal 在非整数缩放下发糊） -->
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <!-- 标准按钮：工具风 —— 白底、细边框、高 26、hover 只加深一档 -->
    <Style TargetType="Button">
        <Setter Property="MinHeight" Value="26"/>
        <Setter Property="MinWidth" Value="88"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="Background" Value="#FDFDFD"/>
        <Setter Property="BorderBrush" Value="{StaticResource CtrlBorderBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TitleFgBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="2"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource CtrlHoverBgBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#C9C9C9"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource CtrlPressBgBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#BEBEBE"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="#F2F2F2"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#E0E0E0"/>
                            <Setter Property="Foreground" Value="#A0A0A0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 强调按钮（Accent）：每张窗口的"确定/是" —— 系统强调色 -->
    <Style x:Key="AccentButton" TargetType="Button">
        <Setter Property="MinHeight" Value="26"/>
        <Setter Property="MinWidth" Value="88"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            CornerRadius="2" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentPressBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentDisabledBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 输入控件：只统一高度与悬停手感，模板保持系统默认（原生输入观感） -->
    <Style TargetType="TextBox">
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="6,3"/>
        <Setter Property="BorderBrush" Value="{StaticResource CtrlBorderBrush}"/>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="8,3"/>
    </Style>

    <!-- 复选框：系统原生控件（自绘 Win11 模板已删 —— 工具软件不需要） -->
    <Style TargetType="CheckBox">
        <Setter Property="Margin" Value="0,4,0,8"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <!-- 细滚动条：Win11 款 —— 无箭头按钮、圆角滑块、透明轨道，全项目所有滚动位置生效 -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="10"/>
        <Setter Property="MinWidth" Value="10"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#C4C4C4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Rectangle Fill="Transparent"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Focusable="False">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <!-- 滑块色跟 ScrollBar.Foreground 走：hover 由触发器改 Foreground -->
                                            <Border Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ScrollBar}}"
                                                    CornerRadius="5" Margin="2"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Rectangle Fill="Transparent"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter Property="Width" Value="Auto"/>
                            <Setter Property="Height" Value="10"/>
                            <Setter Property="MinHeight" Value="10"/>
                            <Setter Property="MinWidth" Value="0"/>
                            <!-- IsDirectionReversed=True 是纵向模板的姿势（WPF Y 轴向下），
                                 横向必须 False，否则拖动方向全反（周工实锤） -->
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="#A8A8A8"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== 分区面板：经典工具风 —— 白底 + 可见实线边框，层次靠边框不靠阴影 ===== -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBgBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Padding" Value="14,12,14,10"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

    <!-- ===== 表格（DataGrid）：主窗口/运行记录共用 ===== -->
    <Style x:Key="TsDataGrid" TargetType="DataGrid">
        <!-- 无外框：边界由最后一列竖线（右）与行网格线（底）天然闭合——
             外框和内部网格线叠加会出 2px 粗线（周工实锤），所有线统一 1px #D9D9D9 -->
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="RowBackground" Value="Transparent"/>
        <Setter Property="AlternatingRowBackground" Value="Transparent"/>
        <Setter Property="GridLinesVisibility" Value="All"/>
        <Setter Property="HorizontalGridLinesBrush" Value="#D9D9D9"/>
        <Setter Property="VerticalGridLinesBrush" Value="#D9D9D9"/>
        <Setter Property="RowHeight" Value="30"/>
        <Setter Property="ColumnHeaderHeight" Value="34"/>
    </Style>

    <Style x:Key="TsColumnHeader" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#F7F7F7"/>
        <Setter Property="Foreground" Value="{StaticResource SubFgBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="10,0"/>
        <!-- 列头竖线 + 底线，与网格线同色同粗（1px #D9D9D9）连贯 -->
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
        <Setter Property="BorderBrush" Value="#D9D9D9"/>
    </Style>

    <!-- 行：只含通用态（hover/选中）。业务语义色（失败红/停用灰/跳过灰）
         由各窗口 BasedOn 派生 —— 字段不同不能混在一处。 -->
    <Style x:Key="TsRow" TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#ECECEC"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#B9D7F2"/>
                <Setter Property="Foreground" Value="{StaticResource TitleFgBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="TsCell" TargetType="DataGridCell">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <!-- ⚠ Setter.Value 里必须是 ControlTemplate（直接放 Border 会在生成第一行
                     单元格时抛 ArgumentException 闪退——空表不渲染所以编译/冒烟都不炸）。
                     素模板：无选中蓝底无焦点框，选中态由行级 TsRow 处理。
                     ⚠ 不要在模板里画竖线：GridLinesVisibility=All 的竖线由 DataGrid 自己画，
                     模板再画一条就是两线重叠（周工实锤"竖线都重了"）。 -->
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="Transparent" Padding="10,6">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- 系统默认 DataGridCell 样式在选中时把 Foreground 强设为白，
                 压掉行级深字 → 蓝底白字。必须在 Cell 级覆盖回来。 -->
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="{StaticResource TitleFgBrush}"/>
                <Setter Property="Background" Value="Transparent"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 单元格文本：超长省略号截断 + tooltip 看全文（表格里不换行、不撑高行） -->
    <Style x:Key="TsCellText" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
    </Style>

    <!-- 卡片标题：用字号做层级（14/近黑），不用装饰 -->
    <Style x:Key="CardTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TitleFgBrush}"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>

    <!-- ===== 文字 ===== -->
    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Margin" Value="0,7,10,0"/>
        <Setter Property="Foreground" Value="{StaticResource BodyFgBrush}"/>
    </Style>

    <Style x:Key="Hint" TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Foreground" Value="{StaticResource SubFgBrush}"/>
        <Setter Property="Margin" Value="0,4,0,8"/>
    </Style>
</ResourceDictionary>
