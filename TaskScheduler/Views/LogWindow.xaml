<Window x:Class="TaskScheduler.Views.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TaskScheduler.Converters"
        Title="运行日志" Height="560" Width="900" MinWidth="600" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft YaHei UI" FontSize="12">
    <Window.Resources>
        <!--
            筛选工具栏的紧凑变体：全局主题的按钮/输入是表单尺寸（高 32、最小宽 88），
            工具栏一行塞不下 —— 这里只覆盖尺寸，模板/配色仍复用全局（观感一致）。
        -->
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="10,0"/>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="MinHeight" Value="26"/>
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="MinHeight" Value="26"/>
        </Style>
    </Window.Resources>
    <DockPanel>

        <!-- 工具栏：灰 chrome 条 -->
        <Border DockPanel.Dock="Top" Background="{StaticResource ChromeBgBrush}"
                BorderBrush="{StaticResource ChromeBorderBrush}" BorderThickness="0,0,0,1"
                Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="显示最近" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox Width="86" ItemsSource="{Binding LineCounts}" SelectedItem="{Binding LineCount}"/>
                    <TextBlock Text="行" VerticalAlignment="Center" Margin="6,0,16,0"/>

                    <TextBlock Text="筛选" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Width="180" VerticalContentAlignment="Center"
                             Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                             ToolTip="按关键字过滤（忽略大小写）。留空显示全部。"/>

                    <CheckBox Content="自动刷新" Margin="16,0,0,0" VerticalAlignment="Center"
                              IsChecked="{Binding AutoRefresh}"/>
                    <CheckBox Content="折行" Margin="12,0,0,0" VerticalAlignment="Center"
                              IsChecked="{Binding WrapLines}"/>
                    <Button Content="立即刷新" Width="82" Margin="16,0,0,0" Command="{Binding RefreshCommand}"/>
                </StackPanel>

                <!-- 2026-09-24：删掉原列 2 的行数状态文本（"500 行"右对齐贴在按钮群中间，
                     看着像残留的孤字——周工圈过两次）。行数信息与左侧"显示最近 N 行"重复，
                     过滤效果直接看列表即可。 -->

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="打开所在目录" Width="106" Command="{Binding OpenFolderCommand}"/>
                    <Button Content="清空日志文件" Width="106" Command="{Binding ClearFileCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 底部提示 -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource ChromeBgBrush}"
                BorderBrush="{StaticResource ChromeBorderBrush}" BorderThickness="0,1,0,0"
                Padding="12,6">
            <TextBlock Foreground="#777777" TextTrimming="CharacterEllipsis">
                <Run Text="日志文件："/>
                <Run Text="{Binding LogPath, Mode=OneWay}"/>
            </TextBlock>
        </Border>

        <!-- 日志正文 -->
        <TextBox x:Name="LogBox" Text="{Binding Text, Mode=OneWay}"
                 IsReadOnly="True"
                 TextWrapping="{Binding WrapLines, Converter={x:Static local:BoolToWrapConverter.Instance}}"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 TextChanged="LogBox_TextChanged"
                 ScrollViewer.ScrollChanged="LogBox_ScrollChanged"
                 FontFamily="Consolas" FontSize="12"
                 BorderThickness="0" Padding="10"
                 Background="#FCFCFD"/>
    </DockPanel>
</Window>
