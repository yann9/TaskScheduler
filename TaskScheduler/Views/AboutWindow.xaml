<Window x:Class="TaskScheduler.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关于" Height="420" Width="540" MinWidth="480" MinHeight="380"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        FontFamily="Microsoft YaHei UI" FontSize="12">
    <DockPanel>
        <!-- 底部按钮：灰 chrome 条 -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource ChromeBgBrush}"
                BorderBrush="{StaticResource ChromeBorderBrush}" BorderThickness="0,1,0,0"
                Padding="16,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="确定" Width="96" IsDefault="True" IsCancel="True"
                        Style="{StaticResource AccentButton}" Click="Ok_Click"/>
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,22,24,16"
                      Background="{StaticResource PageBgBrush}">
            <StackPanel>
                <!-- 主信息区：图标 + 名称 + 版本 -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Image Source="/app.ico" Width="48" Height="48" Margin="0,0,14,0"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding ProductName}" FontSize="20" FontWeight="SemiBold"
                                   Foreground="#1F2937"/>
                        <TextBlock Text="{Binding Version, StringFormat=版本 {0}}" Margin="0,4,0,0"
                                   Foreground="#5B6573"/>
                    </StackPanel>
                </StackPanel>

                <!-- 简介卡片 -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="简介"/>
                        <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                                   Text="{Binding Description}" Margin="0,6,0,0"/>
                        <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                                   Text="{Binding TechInfo}" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 数据目录卡片 -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="数据与日志"/>
                        <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                                   Text="任务配置、运行记录、日志文件都存放在程序数据目录下。点下面的按钮可直接在资源管理器里打开。"
                                   Margin="0,6,0,0"/>
                        <Button Content="打开数据目录" Width="120" Margin="0,10,0,0"
                                HorizontalAlignment="Left" Command="{Binding OpenDataFolderCommand}"/>
                    </StackPanel>
                </Border>

                <!-- 版权 -->
                <TextBlock HorizontalAlignment="Center" Foreground="{StaticResource MetaFgBrush}"
                           Margin="0,4,0,0" Text="{Binding Copyright}"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
