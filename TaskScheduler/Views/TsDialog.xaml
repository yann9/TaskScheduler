<Window x:Class="TaskScheduler.Views.TsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        SizeToContent="Height" MinWidth="440" MaxWidth="560"
        ShowInTaskbar="False"
        FontFamily="Microsoft YaHei UI" FontSize="12"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <!--
        统一消息对话框（经典对话框规格，2026-09-24 第五版）。
        只经由 TsDialog.Show(...) 使用；返回值与 MessageBox 对齐，替换零语义差。
        无边框窗口：没有系统标题栏，不需要拖动，Esc=取消、Enter=主按钮。
    -->
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0" CaptionHeight="0" CornerRadius="0"
                      ResizeBorderThickness="0"/>
    </WindowChrome.WindowChrome>

    <!-- 白底方角 + 可见实线边框（无阴影：工具软件的对话框不需要浮起特效） -->
    <Border Margin="0" Background="White"
            BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
            CornerRadius="0">
        <StackPanel>

            <!-- 标题：图标 + 标题 -->
            <StackPanel Orientation="Horizontal" Margin="20,16,20,0">
                <TextBlock x:Name="IconText" FontFamily="Segoe MDL2 Assets" FontSize="18"
                           VerticalAlignment="Top" Margin="0,2,10,0"/>
                <TextBlock x:Name="TitleText" FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource TitleFgBrush}"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Top"/>
            </StackPanel>

            <!-- 正文 -->
            <TextBlock x:Name="MessageText" Margin="20,10,20,4" TextWrapping="Wrap"
                       Foreground="{StaticResource BodyFgBrush}" LineHeight="20"/>

            <!-- 按钮行：主按钮（Accent）在左，次按钮跟右 —— 与 Win11 对话框一致 -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,12,20,16">
                <Button x:Name="BtnYes" Content="是" Width="92" Margin="0,0,8,0"
                        Style="{StaticResource AccentButton}" Click="Btn_Click" Tag="Yes"/>
                <Button x:Name="BtnNo" Content="否" Width="92" Margin="0,0,8,0"
                        IsCancel="True" Click="Btn_Click" Tag="No"/>
                <Button x:Name="BtnOk" Content="确定" Width="92" Margin="0,0,8,0"
                        Style="{StaticResource AccentButton}" IsDefault="True" Click="Btn_Click" Tag="Ok"/>
                <Button x:Name="BtnCancel" Content="取消" Width="92"
                        IsCancel="True" Click="Btn_Click" Tag="Cancel"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
