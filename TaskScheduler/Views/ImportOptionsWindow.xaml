<Window x:Class="TaskScheduler.Views.ImportOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="导入任务" Height="440" Width="580" MinWidth="500" MinHeight="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        FontFamily="Microsoft YaHei UI" FontSize="12">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{StaticResource ChromeBgBrush}"
                BorderBrush="{StaticResource ChromeBorderBrush}" BorderThickness="0,1,0,0"
                Padding="16,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="确定" Width="96" Margin="0,0,10,0" IsDefault="True"
                        Style="{StaticResource AccentButton}" Click="Ok_Click"/>
                <Button Content="取消" Width="96" IsCancel="True" Click="Cancel_Click"/>
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22,20,22,14"
                      Background="{StaticResource PageBgBrush}">
            <StackPanel>
                <TextBlock Text="导入任务" FontSize="18" FontWeight="SemiBold" Foreground="#1F2937"/>

                <!-- 文件信息 -->
                <Border Style="{StaticResource Card}" Margin="0,14,0,12">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="文件信息"/>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}"
                                       Text="文件" Margin="0,3,14,3"/>
                            <TextBlock x:Name="FileText" Grid.Row="0" Grid.Column="1"
                                       TextWrapping="Wrap" VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}"
                                       Text="可导入任务" Margin="0,3,14,3"/>
                            <TextBlock x:Name="CountText" Grid.Row="1" Grid.Column="1"
                                       VerticalAlignment="Center" FontWeight="SemiBold"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabel}"
                                       Text="导出信息" Margin="0,3,14,3"/>
                            <TextBlock x:Name="ExportInfoText" Grid.Row="2" Grid.Column="1"
                                       TextWrapping="Wrap" VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource FieldLabel}"
                                       Text="提示" Margin="0,3,14,3"/>
                            <TextBlock x:Name="WarningText" Grid.Row="3" Grid.Column="1"
                                       TextWrapping="Wrap" VerticalAlignment="Center" Foreground="#8A6100"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 合并方式 -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="如何处理现有任务"/>
                        <RadioButton x:Name="RadioMerge" GroupName="ImportMode" IsChecked="True"
                                     Margin="0,10,0,6" Content="合并追加：保留现有任务，把导入的任务加在后面"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="20,0,0,10" TextWrapping="Wrap"
                                   Text="推荐。导入的任务会重新分配 ID，不会覆盖同名的现有任务。"/>
                        <RadioButton x:Name="RadioReplace" GroupName="ImportMode"
                                     Margin="0,0,0,6" Content="覆盖全部：用文件里的任务替换整个任务库"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="20,0,0,4" TextWrapping="Wrap"
                                   Foreground="#B3261E"
                                   Text="现有任务会被全部移除。执行前会自动备份当前任务库，备份文件路径会在导入完成后显示。"/>
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                           Text="导入的任务一律处于「停用」状态，并且会清掉运行记录与排期。确认配置无误后，在列表里逐个「启用 / 停用」即可，避免导入瞬间与原任务同时执行。"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
