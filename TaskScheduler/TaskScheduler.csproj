<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>TaskScheduler</RootNamespace>
    <AssemblyName>TaskScheduler</AssemblyName>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <AssemblyTitle>自动化任务调度器</AssemblyTitle>
    <Product>自动化任务调度器</Product>
    <Description>Windows 下基于多种触发器与条件的定时 / 自动化任务桌面程序（支持后台服务保活）</Description>
    <!-- 版本号：与 TaskScheduler.nsi 的 TS_VERSION 保持一致（CI 用 tag 覆盖 nsi）。
         填在这里既给 exe 带上文件版本信息，也供「关于」窗口读取显示。 -->
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <!-- net48 自带 ServiceProcess / Windows.Forms / Registry / SystemEvents / Pipes，无需 Compatibility 桥接包 -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- net48 SDK-style 项目需显式引用以下框架程序集 -->
    <Reference Include="System.ServiceProcess" />
    <Reference Include="System.Net.Http" />
    <!-- 设备接入事件用了 WMI（Win32_VolumeChangeEvent） -->
    <Reference Include="System.Management" />
  </ItemGroup>

  <ItemGroup>
    <!-- 自定义 Main（Program.cs），App.xaml 改为 Page 以免生成默认入口 -->
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

</Project>
